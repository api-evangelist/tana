        {
          "id": "b152988c-f964-455b-9142-b97e1c8bfcf4",
          "name": "Read a full page or a specific section as clean markdown",
          "request": {
            "name": "Read a full page or a specific section as clean markdown",
            "description": {
              "content": "Read a full documentation page or a specific section as clean markdown.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "docs",
                "read"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "path",
                  "value": "<string>",
                  "description": "(Required) Document path in the format product/type/slug, using the singular docType key (e.g. tana/feature/ai-chat, outliner/help/getting-started). This is the path returned in search results."
                },
                {
                  "disabled": false,
                  "key": "section",
                  "value": "<string>",
                  "description": "Heading id to extract a single section (e.g. model-selection). Use \"intro\" for content before the first heading."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "markdown",
                  "description": "Output format: markdown (default, MDX stripped) or raw (original MDX source)."
                }
              ],
              "variable": []
            },
            "header": [
              {
