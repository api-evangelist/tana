          "request": {
            "name": "Search documentation by text pattern",
            "description": {
              "content": "Search documentation by text pattern, optionally scoped to feature areas. Returns matching document paths, titles, descriptions, and summaries.",
              "type": "text/plain"
            },
            "url": {
